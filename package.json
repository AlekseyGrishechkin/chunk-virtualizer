  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.11",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.2",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}

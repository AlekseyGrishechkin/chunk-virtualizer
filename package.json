{
  "name": "@aleksey_grishechkin/react-chunk-virtualizer",
  "version": "1.1.0",
  "description": "A React hook for list virtualization that renders items incrementally in chunks as the user scrolls.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --clean",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "virtual-scroll",
    "infinite-scroll",
    "windowing",
    "carousel",
    "chunk-render",
    "progressive-loading",
    "horizontal-scroll"
  ],
  "author": "Alexey Grishechkin",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "jsdom": "^30.1.2",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
